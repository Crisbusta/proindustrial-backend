# ── App ──────────────────────────────────────────────────
APP_ENV=development          # development | production

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/proindustrial?sslmode=disable

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-32-char-secret    # REQUIRED in production

# ── Server ───────────────────────────────────────────────
PORT=8080
CORS_ORIGIN=http://localhost:3001    # sin barra final: se devuelve tal cual en Access-Control-Allow-Origin
APP_BASE_URL=http://localhost:3001

# ── Proxies confiables ───────────────────────────────────
# Sin una de estas dos, gin acepta el X-Forwarded-For de cualquiera y el
# rate limit por IP se puede evadir con una cabecera. El backend arranca
# igual y deja un WARNING en los logs.
#
# TRUSTED_PLATFORM solo aplica a plataformas que gin conoce (cloudflare,
# fly-io, google-app-engine). No la pongas si no estás detrás de una de
# ellas: gin buscaría una cabecera inexistente y caería a la IP del proxy,
# metiendo a todos los visitantes en un mismo bucket de rate limit.
TRUSTED_PLATFORM=
TRUSTED_PROXIES=            # alternativa: lista de CIDR separados por coma

# ── Initial provider password (admin panel) ──────────────
# Solo para desarrollo: fija la MISMA contraseña inicial para todas las
# empresas aprobadas. Se ignora cuando APP_ENV=production.
INITIAL_PASSWORD=           # si está vacía se genera una al azar por aprobación

# ── Email — Resend (preferred) ───────────────────────────
RESEND_API_KEY=
RESEND_FROM=noreply@yourdomain.com

# ── Email — SMTP fallback ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Storage ──────────────────────────────────────────────
STORAGE_DRIVER=local           # local | s3
STORAGE_DIR=./uploads          # local only: directory for uploaded files

# S3 / Cloudflare R2 (only needed when STORAGE_DRIVER=s3)
# For R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#         S3_REGION=auto
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE=                # e.g. https://cdn.proindustrial.cl
